FROM python:3.12-slim

WORKDIR /app

COPY deployment/docker/all_in_one_kdcube/secrets/requirements.txt /app/requirements.txt
COPY deployment/docker/all_in_one_kdcube/secrets/host_vault/requirements.txt /app/host-vault-requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt -r /app/host-vault-requirements.txt

COPY deployment/docker/all_in_one_kdcube/secrets/secrets_server.py /app/secrets_server.py
COPY deployment/docker/all_in_one_kdcube/secrets/secretsctl.py /app/secretsctl.py
COPY deployment/docker/all_in_one_kdcube/secrets/secrets_service_entrypoint.py /app/secrets_service_entrypoint.py
COPY deployment/docker/all_in_one_kdcube/secrets/host_vault/broker_server.py /app/host_vault/broker_server.py
COPY src/kdcube-ai-app/kdcube_ai_app/__init__.py /app/kdcube_ai_app/__init__.py
COPY src/kdcube-ai-app/kdcube_ai_app/infra/secrets/runtime_contract.py /app/kdcube_ai_app/infra/secrets/runtime_contract.py
COPY src/kdcube-ai-app/kdcube_ai_app/infra/secrets/runtime_http.py /app/kdcube_ai_app/infra/secrets/runtime_http.py
COPY src/kdcube-ai-app/kdcube_ai_app/infra/secrets/host_vault /app/kdcube_ai_app/infra/secrets/host_vault
RUN touch /app/kdcube_ai_app/infra/__init__.py /app/kdcube_ai_app/infra/secrets/__init__.py \
    && mkdir -p /run/kdcube-host-vault-identity

ENV SECRETS_PORT=7777
ENV SECRETS_STORE_PATH=/run/kdcube-secrets/store.json
ENV KDCUBE_SECRETS_SERVICE_BACKEND=ephemeral
ENV PYTHONPATH=/app

CMD ["python", "/app/secrets_service_entrypoint.py"]
